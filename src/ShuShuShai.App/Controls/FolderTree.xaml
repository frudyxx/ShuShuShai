<UserControl x:Class="ShuShuShai.App.Controls.FolderTree" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:ShuShuShai.App.ViewModels">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="Bool"/><HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
    <StackPanel><DockPanel LastChildFill="True"><Button Content="×" FontSize="21" FontWeight="Bold" Foreground="#F1B3A7" Padding="7,0" DockPanel.Dock="Right" Click="Remove" Visibility="Collapsed" x:Name="RemoveButton" ToolTip="移除此待导入主目录；不删除文件"/><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding Selectable}" ToolTip="{Binding Path}" Margin="3,6"/></DockPanel>
      <CheckBox x:Name="AllChildren" Content="包含所有子文件夹" ToolTip="勾选或取消勾选主目录下的所有子文件夹。" IsChecked="{Binding AllChildrenSelected,Mode=OneWay}" Click="ToggleChildren" Margin="22,0,0,7" Visibility="Collapsed"/>
    </StackPanel><HierarchicalDataTemplate.Triggers><DataTrigger Binding="{Binding IsRoot}" Value="True"><Setter TargetName="RemoveButton" Property="Visibility" Value="{Binding ImportControls,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource Bool}}"/><Setter TargetName="AllChildren" Property="Visibility" Value="{Binding ImportControls,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource Bool}}"/></DataTrigger></HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate></UserControl.Resources>
  <TreeView x:Name="Tree" Background="Transparent" Foreground="#EEEEEE" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">
    <TreeView.Template><ControlTemplate TargetType="TreeView"><Border Background="{TemplateBinding Background}"><ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></TreeView.Template>
    <TreeView.Resources>
      <Style TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=TwoWay}"/>
        <Setter Property="Foreground" Value="#E9E9E9"/>
      </Style>
    </TreeView.Resources>
  </TreeView>
</UserControl>
