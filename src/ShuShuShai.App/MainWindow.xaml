<Window x:Class="ShuShuShai.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:ShuShuShai.App.Controls" xmlns:svc="clr-namespace:ShuShuShai.App.Services" xmlns:core="clr-namespace:ShuShuShai.Core;assembly=ShuShuShai.Core" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="舒舒筛" Icon="Assets/ShuShuShai.ico" Width="1480" Height="960" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}" PreviewKeyDown="OnKey" Closing="OnClosing" MouseMove="WindowMouseMove">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Bool"/>
  <c:CurrentPhotoChoice x:Key="CurrentPhotoChoice"/>
  <Style x:Key="HeaderAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Height" Value="30"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Padding" Value="9,2"/><Setter Property="Margin" Value="2,0"/>
  </Style>
  <Style x:Key="WindowAction" TargetType="Button" BasedOn="{StaticResource HeaderAction}">
   <Setter Property="Width" Value="36"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="15"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style x:Key="PhotoChoiceButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Style.Triggers>
    <DataTrigger Value="True">
     <DataTrigger.Binding>
      <MultiBinding Converter="{StaticResource CurrentPhotoChoice}">
       <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
       <Binding Path="Current.Stars"/>
       <Binding Path="Current.Decision"/>
      </MultiBinding>
     </DataTrigger.Binding>
     <Setter Property="Background" Value="#514634"/>
     <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
     <Setter Property="Foreground" Value="#FFE2A3"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource ToolHint}">
   <Setter Property="Background" Value="#222222"/><Setter Property="BorderBrush" Value="#464646"/><Setter Property="BorderThickness" Value="2"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/>
   <Setter Property="ContextMenu"><Setter.Value><ContextMenu><MenuItem Header="照片" IsEnabled="False"/></ContextMenu></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="White"/></DataTrigger><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="ThumbTemplate">
   <Border Style="{StaticResource Tile}" Tag="{Binding}" MouseLeftButtonDown="OnTile" ToolTip="{Binding JpgPath}"><StackPanel>

    <c:Thumbnail Path="{Binding JpgPath}" Height="{Binding DataContext.ThumbnailHeight,RelativeSource={RelativeSource AncestorType=Window}}"/>
    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/><TextBlock Text="{Binding Caption}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
   </StackPanel></Border>
  </DataTemplate>
 </Window.Resources>
 <Grid x:Name="RootLayout">
  <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="40"/><RowDefinition/></Grid.RowDefinitions>
  <Border x:Name="HeaderBar" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,2"><DockPanel>
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
    <Button Style="{StaticResource HeaderAction}" Content="撤回上一步" Tag="{x:Static svc:ShortcutAction.Undo}" Click="RunTool" ToolTip="{Binding Shortcuts[Undo], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanUndo}" Visibility="{Binding HasTask,Converter={StaticResource Bool}}"/>
    <Button Style="{StaticResource HeaderAction}" Content="设置" Click="ShowSettings" ToolTip="更改快捷键、查看版本和管理历史记录。"/>
    <Button Style="{StaticResource Primary}" Content="筛选完毕" Click="Export" Height="30" Padding="10,2" Margin="2,0,8,0" FontSize="12" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="按星级或取舍选择照片，查看并执行导出计划。" Visibility="{Binding HasTask,Converter={StaticResource Bool}}"/>
    <Button Style="{StaticResource WindowAction}" Content="−" Click="MinimizeWindow" AutomationProperties.Name="最小化" ToolTip="最小化窗口。"/>
    <Button x:Name="MaximizeButton" Style="{StaticResource WindowAction}" Content="□" Click="ToggleMaximized" AutomationProperties.Name="最大化" ToolTip="最大化窗口。"/>
    <Button Style="{StaticResource WindowAction}" Content="×" Click="CloseWindow" AutomationProperties.Name="关闭" ToolTip="关闭窗口并处理未保存的进度。"/>
   </StackPanel>
   <Button Style="{StaticResource HeaderAction}" Click="Home" AutomationProperties.Name="舒舒筛，返回选片历史" ToolTip="返回选片历史" Background="Transparent" BorderBrush="Transparent">
    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource BrandIconImage}" Width="20" Height="20"/><TextBlock Text="舒舒筛" FontSize="15" FontWeight="SemiBold" Margin="7,0,0,0"/></StackPanel>
   </Button><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="10,0" Foreground="{StaticResource Muted}" Visibility="{Binding HasTask,Converter={StaticResource Bool}}"/>
  </DockPanel></Border>
  <Grid Grid.Row="1" x:Name="HomePage" Visibility="{Binding IsHome,Converter={StaticResource Bool}}" Margin="45">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="30,0,48,0">
    <Image Source="{StaticResource BrandIconImage}" Width="72" Height="72" HorizontalAlignment="Left"/>
    <TextBlock Text="舒舒筛" FontSize="43" FontWeight="SemiBold" Margin="0,9,0,0"/>
    <TextBlock Text="S H U S H U S H A I" FontSize="11" Foreground="{StaticResource Accent}" Margin="2,0,0,14"/>
    <TextBlock Text="离线选片 · JPG / RAW 原文件整理" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,0,0,22"/>
    <Button Content="＋  导入照片文件夹" FontSize="16" HorizontalAlignment="Left" Margin="0" Padding="14,10" Click="NewImport" ToolTip="选择照片的主目录，建立选片任务。" Style="{StaticResource Primary}"/>
    <TextBlock Text="逐层勾选来源，评分和取舍自动保存在本机。" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource Muted}"/>
   </StackPanel>
   <Grid Grid.Column="1" Margin="10,12" VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="继续选片" FontSize="21" Margin="6,0,0,16"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding History}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate>
 <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="3,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Button Tag="{Binding}" Click="ContinueTask" ToolTip="打开历史任务并恢复选片进度。" Padding="0" Margin="0" Width="180" Height="120" VerticalAlignment="Top"><ItemsControl ItemsSource="{Binding HistoryPreviews}" Width="180" Height="120"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="2" Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><c:Thumbnail Path="{Binding JpgPath}" Margin="2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Button>
  <StackPanel Grid.Column="2"><TextBlock Text="{Binding SourceTitle}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding HistoryText}" TextWrapping="Wrap" Margin="0,5" FontSize="11" Foreground="{StaticResource Muted}"/><WrapPanel>
   <Button Content="继续任务 →" Tag="{Binding}" Click="ContinueTask" ToolTip="打开历史任务并恢复选片进度。" Padding="7,4" Margin="0,2,6,5"/>
   <Button Content="删除" Tag="{Binding}" Click="RemoveHistory" ToolTip="选择移到设置或永久删除这条历史记录。" Padding="7,4" Margin="0,2,0,5"/>
  </WrapPanel><Expander Header="目录详情" FontSize="11"><TextBlock Text="{Binding SourceDetails}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></Expander></StackPanel>
 </Grid></Border>
</DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid>
  </Grid>
  <Grid Grid.Row="1" x:Name="TaskArea" Visibility="{Binding HasTask,Converter={StaticResource Bool}}">
   <Grid.RowDefinitions><RowDefinition MinHeight="210"/><RowDefinition x:Name="ToolsSplitRow" Height="6"/><RowDefinition x:Name="ToolsRow" Height="96" MinHeight="48" MaxHeight="180"/><RowDefinition x:Name="FilmSplitRow" Height="6"/><RowDefinition x:Name="FilmRow" Height="180" MinHeight="88" MaxHeight="360"/></Grid.RowDefinitions>
   <Grid x:Name="WorkArea">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftEdgeColumn" Width="16"/><ColumnDefinition x:Name="LeftColumn" Width="230" MinWidth="160" MaxWidth="420"/><ColumnDefinition x:Name="LeftSplitColumn" Width="6"/><ColumnDefinition MinWidth="320"/><ColumnDefinition x:Name="RightSplitColumn" Width="6"/><ColumnDefinition x:Name="RightColumn" Width="280" MinWidth="220" MaxWidth="440"/><ColumnDefinition x:Name="RightEdgeColumn" Width="16"/></Grid.ColumnDefinitions>
    <Button x:Name="LeftToggle" Grid.Column="0" Content="◀" Click="ToggleLeft" Padding="0" Margin="0" ToolTip="展开 / 收起来源面板"/><Button x:Name="RightToggle" Grid.Column="6" Content="▶" Click="ToggleRight" Padding="0" Margin="0" ToolTip="展开 / 收起信息面板"/><Border Grid.Column="1" x:Name="LeftPanel" Background="{StaticResource Panel}"><Grid Margin="9"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><DockPanel><Button Content="＋ 添加文件夹" DockPanel.Dock="Right" Click="AddImport" ToolTip="将其他目录添加到当前任务。" IsEnabled="{Binding Ready}" Padding="5,3" FontSize="11"/><TextBlock Text="来源" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/></DockPanel><WrapPanel><RadioButton x:Name="AllSourcesRadio" Content="全部来源" ToolTip="显示所有已导入目录中的 JPG。" GroupName="Sources" IsChecked="True" Checked="AllSourcesChecked"/><RadioButton x:Name="SpecificSourcesRadio" Content="指定来源" ToolTip="仅显示勾选目录中的 JPG。" GroupName="Sources" Checked="SpecificSourcesChecked"/></WrapPanel></StackPanel>
     <c:FolderTree Grid.Row="1" x:Name="SourceTree"/>
     <StackPanel Grid.Row="2">
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="3,8,3,4"><StackPanel><TextBlock Text="任务统计" FontWeight="SemiBold" Margin="0,0,0,4"/><TextBlock Text="{Binding Stats}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
      <WrapPanel><Button Content="刷新扫描" Click="RefreshScan" ToolTip="重新检查已导入目录中的照片文件。" IsEnabled="{Binding Ready}" Padding="5,3" FontSize="11"/><Button Content="配对与提示" Click="Pairing" ToolTip="查看配对冲突和扫描提示。" IsEnabled="{Binding Ready}" Padding="5,3" FontSize="11"/></WrapPanel>
      <StackPanel Visibility="{Binding Busy,Converter={StaticResource Bool}}"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11"/><Button Content="取消扫描" Click="Cancel" ToolTip="停止扫描并保留原选片记录。" HorizontalAlignment="Left" Padding="5,3"/></StackPanel>
     </StackPanel>
    </Grid></Border>
    <GridSplitter x:Name="LeftSplitter" ToolTip="拖动调整来源面板宽度。" Grid.Column="2" Width="6" HorizontalAlignment="Stretch" Background="#3A3A3A" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="LayoutDragged"/>
    <Grid Grid.Column="3" x:Name="Workspace" SizeChanged="WorkspaceSize">
     <c:PhotoViewer x:Name="LargeViewer" Path="{Binding Current.JpgPath}" Visibility="{Binding IsLarge,Converter={StaticResource Bool}}" MouseLeftButtonDown="LargeClicked"/>
     <ListBox x:Name="GridList" ItemsSource="{Binding Rows}" Visibility="{Binding IsGrid,Converter={StaticResource Bool}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0.5" ScrollViewer.ScrollChanged="GridScrolled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Photos}" ItemTemplate="{StaticResource ThumbTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <ItemsControl x:Name="ComparisonView" ItemsSource="{Binding Comparison}" Visibility="{Binding IsCompare,Converter={StaticResource Bool}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CompareColumns}" Rows="{Binding CompareRows}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Tile}" Tag="{Binding}" MouseLeftButtonDown="CompareClicked"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel><Button Content="移出对比" DockPanel.Dock="Right" Click="RemoveCompare" ToolTip="将这张照片移出当前对比。" Tag="{Binding}" Padding="5,2" FontSize="10"/><TextBlock Text="{Binding CompareRole}" Foreground="{StaticResource Accent}" Margin="0,0,5,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ActiveText}" FontSize="10" Margin="5,0"/></DockPanel><c:PhotoViewer Grid.Row="1" Path="{Binding JpgPath}" Loaded="ComparisonViewerLoaded"/></Grid></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock x:Name="EmptyState" Text="当前没有可浏览 JPG，请调整来源或筛选条件。" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20" FontSize="17" IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>
    <GridSplitter x:Name="RightSplitter" ToolTip="拖动调整信息面板宽度。" Grid.Column="4" Width="6" HorizontalAlignment="Stretch" Background="#3A3A3A" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="LayoutDragged"/>
    <Border Grid.Column="5" x:Name="RightPanel" Background="{StaticResource Panel}"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <StackPanel x:Name="HistogramSection"><DockPanel><TextBlock Text="JPG 直方图" FontWeight="SemiBold" Margin="0,4,0,8"/></DockPanel><c:Histogram Height="112" Data="{Binding Histogram}"/><TextBlock Text="{Binding HistogramStatus}" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6"/><TextBlock Text="仅反映 JPG；不代表 RAW 高光余量" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,9"/></StackPanel>
     <ScrollViewer Grid.Row="1" x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Text="{Binding CurrentTitle}" TextWrapping="Wrap" Margin="0,10" FontWeight="SemiBold"/><TextBlock Text="{Binding OperationScope}" Foreground="{StaticResource Accent}" Margin="0,5"/>
      <WrapPanel x:Name="RatingChoices" IsEnabled="{Binding HasSelection}">
       <WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource PhotoChoiceButton}"><Setter Property="Padding" Value="6,4"/></Style></WrapPanel.Resources>
       <Button Content="0" Click="Stars" ToolTip="{Binding Shortcuts[Unrate], RelativeSource={RelativeSource AncestorType=Window}}"><Button.Tag><sys:Int32>0</sys:Int32></Button.Tag></Button>
       <Button Content="1★" Click="Stars" ToolTip="{Binding Shortcuts[Rate1], RelativeSource={RelativeSource AncestorType=Window}}"><Button.Tag><sys:Int32>1</sys:Int32></Button.Tag></Button>
       <Button Content="2★" Click="Stars" ToolTip="{Binding Shortcuts[Rate2], RelativeSource={RelativeSource AncestorType=Window}}"><Button.Tag><sys:Int32>2</sys:Int32></Button.Tag></Button>
       <Button Content="3★" Click="Stars" ToolTip="{Binding Shortcuts[Rate3], RelativeSource={RelativeSource AncestorType=Window}}"><Button.Tag><sys:Int32>3</sys:Int32></Button.Tag></Button>
       <Button Content="4★" Click="Stars" ToolTip="{Binding Shortcuts[Rate4], RelativeSource={RelativeSource AncestorType=Window}}"><Button.Tag><sys:Int32>4</sys:Int32></Button.Tag></Button>
       <Button Content="5★" Click="Stars" ToolTip="{Binding Shortcuts[Rate5], RelativeSource={RelativeSource AncestorType=Window}}"><Button.Tag><sys:Int32>5</sys:Int32></Button.Tag></Button>
      </WrapPanel>
      <WrapPanel IsEnabled="{Binding HasSelection}">
       <WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource PhotoChoiceButton}"><Setter Property="Padding" Value="7,6"/></Style></WrapPanel.Resources>
       <Button Content="保留 P" Tag="{x:Static core:Decision.Keep}" Click="Mark" ToolTip="{Binding Shortcuts[Keep], RelativeSource={RelativeSource AncestorType=Window}}"/>
       <Button Content="淘汰 X" Tag="{x:Static core:Decision.Reject}" Click="Mark" ToolTip="{Binding Shortcuts[Reject], RelativeSource={RelativeSource AncestorType=Window}}"/>
       <Button Content="未定 U" Tag="{x:Static core:Decision.Undecided}" Click="Mark" ToolTip="{Binding Shortcuts[Undecide], RelativeSource={RelativeSource AncestorType=Window}}"/>
      </WrapPanel>
      <TextBlock Text="{Binding Metadata}" LineHeight="24" TextWrapping="Wrap" Margin="0,16,0,12" FontSize="12"/><TextBlock Text="{Binding CurrentPaths}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}"/><Button Content="重新定位此 JPG" Click="Relocate" ToolTip="为当前照片重新指定 JPG 文件，保留选片记录。"/><Button Content="查看此照片配对" Click="CurrentPairing" ToolTip="查看当前照片对应的 RAW 文件。"/>
     </StackPanel></ScrollViewer>
    </Grid></Border>
   </Grid>
   <Thumb x:Name="ToolsSplitter" Grid.Row="1" Height="6" Style="{StaticResource WorkspaceDivider}" Cursor="SizeNS" DragDelta="ToolsResized" DragCompleted="LayoutDragged" ToolTip="拖矮切成单行。放不下的工具可以横向滚动查看。"/>
<Border Grid.Row="2" x:Name="Toolbar" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1">
 <Border.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="2"/></Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="5,7"/></Style></Border.Resources>
 <ScrollViewer x:Name="ToolbarScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="ToolbarWheel"><StackPanel x:Name="ToolRows" Margin="5,3" VerticalAlignment="Center">
  <StackPanel Orientation="Horizontal"><TextBlock Text="视图" FontSize="11" Foreground="{StaticResource Muted}" Margin="3"/><Button Content="大图" Tag="{x:Static svc:ShortcutAction.Large}" Click="RunTool" ToolTip="{Binding Shortcuts[Large], RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="总览" Tag="{x:Static svc:ShortcutAction.Overview}" Click="RunTool" ToolTip="{Binding Shortcuts[Overview], RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="对比选中" Tag="{x:Static svc:ShortcutAction.Compare}" Click="RunTool" ToolTip="{Binding Shortcuts[Compare], RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="全屏" Tag="{x:Static svc:ShortcutAction.FullScreen}" Click="RunTool" ToolTip="{Binding Shortcuts[FullScreen], RelativeSource={RelativeSource AncestorType=Window}}"/>
   <Border Width="1" Height="22" Background="#555555" Margin="6,0"/><Button Content="上一张" Tag="{x:Static svc:ShortcutAction.Previous}" Click="RunTool" ToolTip="{Binding Shortcuts[Previous], RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="下一张" Tag="{x:Static svc:ShortcutAction.Next}" Click="RunTool" ToolTip="{Binding Shortcuts[Next], RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="适合" Tag="{x:Static svc:ShortcutAction.Fit}" Click="RunTool" ToolTip="{Binding Shortcuts[Fit], RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="100%" Tag="{x:Static svc:ShortcutAction.ActualPixels}" Click="RunTool" ToolTip="{Binding Shortcuts[ActualPixels], RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="−" Tag="{x:Static svc:ShortcutAction.ZoomOut}" Click="RunTool" ToolTip="{Binding Shortcuts[ZoomOut], RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="+" Tag="{x:Static svc:ShortcutAction.ZoomIn}" Click="RunTool" ToolTip="{Binding Shortcuts[ZoomIn], RelativeSource={RelativeSource AncestorType=Window}}"/>
   <WrapPanel Visibility="{Binding IsCompare,Converter={StaticResource Bool}}"><CheckBox Content="联动缩放" ToolTip="同时缩放或平移对比中的照片。" IsChecked="{Binding LinkedZoom}"/><CheckBox Content="联动评分" IsChecked="{Binding CompareLinkedRating}" ToolTip="同时控制星级及保留/淘汰/未定；关闭时只操作当前黄框照片"/><Button Content="设为参考" Click="SetReference" ToolTip="将活动照片设为双图对比的参考图。" Visibility="{Binding IsDual,Converter={StaticResource Bool}}"/></WrapPanel>
   <Button Content="更多 ▾" Click="More" ToolTip="选择照片排序方式和其他选片操作。"><Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}"><MenuItem Header="评分后下一张" ToolTip="在大图中给单张照片评分或标记后自动翻片。" IsCheckable="True" IsChecked="{Binding AutoAdvance}"/><Separator/><MenuItem Header="按文件名自然排序" Tag="0" IsCheckable="True" Click="SortPhotos" ToolTip="按文件名中的文字和数字顺序浏览。"/><MenuItem Header="按拍摄时间排序" Tag="1" IsCheckable="True" Click="SortPhotos" ToolTip="缺少拍摄时间的照片使用文件修改时间。"/></ContextMenu></Button.ContextMenu></Button>
  </StackPanel>
  <StackPanel Orientation="Horizontal" Margin="4,2"><TextBlock Text="星级" FontSize="11"/><ComboBox Width="105" SelectedIndex="{Binding FilterMode}" ToolTip="按星级条件筛选当前来源中的照片。"><ComboBoxItem Content="全部星级"/><ComboBoxItem Content="仅未评分"/><ComboBoxItem Content="大于等于"/><ComboBoxItem Content="小于等于"/><ComboBoxItem Content="等于"/></ComboBox><ComboBox Width="60" SelectedValuePath="Tag" SelectedValue="{Binding FilterStars}" ToolTip="设置星级筛选条件的目标星数。"><ComboBoxItem Content="1★"><ComboBoxItem.Tag><sys:Int32 xmlns:sys="clr-namespace:System;assembly=System.Runtime">1</sys:Int32></ComboBoxItem.Tag></ComboBoxItem><ComboBoxItem Content="2★"><ComboBoxItem.Tag><sys:Int32 xmlns:sys="clr-namespace:System;assembly=System.Runtime">2</sys:Int32></ComboBoxItem.Tag></ComboBoxItem><ComboBoxItem Content="3★"><ComboBoxItem.Tag><sys:Int32 xmlns:sys="clr-namespace:System;assembly=System.Runtime">3</sys:Int32></ComboBoxItem.Tag></ComboBoxItem><ComboBoxItem Content="4★"><ComboBoxItem.Tag><sys:Int32 xmlns:sys="clr-namespace:System;assembly=System.Runtime">4</sys:Int32></ComboBoxItem.Tag></ComboBoxItem><ComboBoxItem Content="5★"><ComboBoxItem.Tag><sys:Int32 xmlns:sys="clr-namespace:System;assembly=System.Runtime">5</sys:Int32></ComboBoxItem.Tag></ComboBoxItem></ComboBox><TextBlock Text="取舍"/><ComboBox Width="110" SelectedIndex="{Binding DecisionFilter}" ToolTip="按保留、未定或淘汰筛选照片。"><ComboBoxItem Content="全部状态"/><ComboBoxItem Content="未定"/><ComboBoxItem Content="保留"/><ComboBoxItem Content="淘汰"/></ComboBox><TextBlock Text="{Binding Position}" Margin="12,0" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding OperationScope}" FontSize="11" Foreground="{StaticResource Accent}" Margin="4"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsGrid,Converter={StaticResource Bool}}"><TextBlock Text="缩略图" FontSize="11" Margin="8,0,0,0"/><Slider x:Name="OverviewSize" ToolTip="调整总览中缩略图的大小。" Width="85" Minimum="115" Maximum="360" Value="{Binding ThumbnailSize}" Margin="5,0" VerticalAlignment="Center"/></StackPanel></StackPanel>
 </StackPanel></ScrollViewer>
</Border>
<Thumb x:Name="FilmSplitter" Grid.Row="3" Height="6" Style="{StaticResource WorkspaceDivider}" Cursor="SizeNS" DragDelta="FilmResized" DragCompleted="LayoutDragged" ToolTip="拖动调整胶片条高度"/>
   <ListBox Grid.Row="4" x:Name="Film" ItemsSource="{Binding Visible}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="FilmWheel" VirtualizingPanel.CacheLength="1" ScrollViewer.CanContentScroll="True">
 <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
 <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Tile}" Tag="{Binding}" MouseLeftButtonDown="FilmTile" Width="{Binding DataContext.FilmTileWidth,RelativeSource={RelativeSource AncestorType=Window}}"><StackPanel><c:Thumbnail Path="{Binding JpgPath}" Height="{Binding DataContext.FilmThumbnailHeight,RelativeSource={RelativeSource AncestorType=Window}}"/><TextBlock Text="{Binding FilmCaption}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
</ListBox>
  </Grid>
  <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="620" Margin="12,10" Panel.ZIndex="48">
   <Border x:Name="ScanNotice" Background="#EE272727" CornerRadius="5" Padding="8,4" Margin="0,0,0,4" Visibility="Collapsed"><DockPanel><Button Content="取消扫描" DockPanel.Dock="Right" Click="Cancel" ToolTip="停止扫描并保留原选片记录。" Padding="5,3"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="4"/></DockPanel></Border>
   <Border x:Name="SaveNotice" Background="#F049312A" CornerRadius="5" Padding="8,4" Margin="0,0,0,4" Visibility="Collapsed"><DockPanel><Button Content="重试保存" DockPanel.Dock="Right" Click="RetrySave" ToolTip="再次保存当前任务。" Padding="5,3"/><TextBlock Text="{Binding SaveError}" TextWrapping="Wrap" Margin="4"/></DockPanel></Border>
   <Border x:Name="Toast" Background="#EE272727" CornerRadius="5" Padding="10,5" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="105" FontSize="12"/></Border>
  </StackPanel>
  <Border x:Name="FullScreenTools" Grid.RowSpan="3" Background="#D9292929" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="6" Margin="12" Padding="7" Visibility="Collapsed" Panel.ZIndex="50"><StackPanel Orientation="Horizontal"><Button Content="退出全屏 Esc" Tag="{x:Static svc:ShortcutAction.FullScreen}" Click="RunTool" ToolTip="{Binding Shortcuts[FullScreen], RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="上一张" Tag="{x:Static svc:ShortcutAction.Previous}" Click="RunTool" ToolTip="{Binding Shortcuts[Previous], RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="下一张" Tag="{x:Static svc:ShortcutAction.Next}" Click="RunTool" ToolTip="{Binding Shortcuts[Next], RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="适合" Tag="{x:Static svc:ShortcutAction.Fit}" Click="RunTool" ToolTip="{Binding Shortcuts[Fit], RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="100%" Tag="{x:Static svc:ShortcutAction.ActualPixels}" Click="RunTool" ToolTip="{Binding Shortcuts[ActualPixels], RelativeSource={RelativeSource AncestorType=Window}}"/><TextBlock Text="{Binding OperationScope}" Foreground="{StaticResource Accent}" FontSize="11" Margin="4,0"/></StackPanel></Border>
  <Border x:Name="FullScreenStatus" Grid.RowSpan="3" Background="#DD202020" HorizontalAlignment="Right" VerticalAlignment="Bottom"
          CornerRadius="5" Margin="16" Padding="12,7" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="49">
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="{Binding Current.StarDisplay}" Foreground="{StaticResource Accent}"/>
    <TextBlock Text="{Binding Current.DecisionText, TargetNullValue=—}" Margin="8,0"/>
    <TextBlock Text="{Binding PhotoPosition}"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
