<Window x:Class="ShuShuShai.App.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="舒舒筛 · 正在启动" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Width="336" Height="194" Background="#1A1816">
  <Border BorderThickness="1" BorderBrush="#463D30" Padding="14">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid Width="68" Height="68" HorizontalAlignment="Center">
        <Image Source="{StaticResource BrandMarkImage}" Clip="M0,0 H68 L0,68 Z">
          <Image.RenderTransform><TranslateTransform x:Name="UpperOffset"/></Image.RenderTransform>
        </Image>
        <Image Source="{StaticResource BrandMarkImage}" Clip="M68,0 V68 H0 Z">
          <Image.RenderTransform><TranslateTransform x:Name="LowerOffset"/></Image.RenderTransform>
        </Image>
      </Grid>
      <StackPanel x:Name="Wordmark" Margin="0,6,0,0">
        <TextBlock Text="舒舒筛" FontSize="23" FontWeight="SemiBold" Foreground="#F3EFE8" HorizontalAlignment="Center"/>
        <TextBlock Text="S H U S H U S H A I" FontSize="10" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
      </StackPanel>
      <TextBlock x:Name="LoadingStatus" Text="正在启动" Foreground="{StaticResource Muted}"
                 FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Hidden"/>
    </StackPanel>
  </Border>
</Window>
